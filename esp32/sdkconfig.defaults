# An ESP32-S3-N16R8 module: 16 MB of flash, 8 MB of octal PSRAM (which
# takes GPIO 35-37).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The log on UART0 (the board's USB-serial port); the chip's own USB is
# the phone's host.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
# TLS 1.2 with records of 16 KiB in and 4 KiB out (the head unit sends
# only short messages), as SDLINK.UF2 has them.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# The card's loop has the second core to itself (main/sdcard.c): its idle
# task never runs, and everything else is kept on the first.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=y
# The chip's own RAM is the card's and the stream's: Wi-Fi's, lwIP's and
# TLS's buffers go to the PSRAM where they can.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# The card's loop takes no interrupt on the second core.
CONFIG_ESP_INT_WDT_CHECK_CPU1=n
# The phone's bytes: with lwIP's 5760 bytes of TCP window the link fell
# under the music's 190 KB/s whenever a round trip took 30 ms, and the
# sound ran dry (a 193, 2026-11-23).
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=16
