# An ESP32-S3-N16R8 module: 16 MB of flash, 8 MB of octal PSRAM (which
# takes GPIO 35-37).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The log on UART0 (the board's USB-serial port); the chip's own USB is
# the phone's host.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
# TLS 1.2 with records of 16 KiB in and 4 KiB out (the head unit sends
# only short messages), as SDLINK.UF2 has them.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
